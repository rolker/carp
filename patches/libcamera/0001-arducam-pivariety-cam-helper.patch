+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * camera helper for Arducam Pivariety boards
+ *
+ * The Pivariety kernel driver exposes the sensor through an on-board MCU and
+ * reports every sensor as "arducam-pivariety". Gain is passed to the MCU as a
+ * linear code in hundredths (100 = 1x), matching Arducam's own helper. Timing
+ * follows the IMX290 family (the IMX462 is the sensor on the B0444).
+ */
+
+#include <algorithm>
+#include <cmath>
+
+#include "cam_helper.h"
+
+using namespace RPiController;
+
+class CamHelperArducamPivariety : public CamHelper
+{
+public:
+	CamHelperArducamPivariety();
+	uint32_t gainCode(double gain) const override;
+	double gain(uint32_t gainCode) const override;
+	unsigned int hideFramesStartup() const override;
+	unsigned int hideFramesModeSwitch() const override;
+
+private:
+	/*
+	 * Smallest difference between the frame length and integration time,
+	 * in units of lines.
+	 */
+	static constexpr int frameIntegrationDiff = 2;
+	static constexpr double gainScale = 100.0;
+};
+
+CamHelperArducamPivariety::CamHelperArducamPivariety()
+	: CamHelper({}, frameIntegrationDiff)
+{
+}
+
+uint32_t CamHelperArducamPivariety::gainCode(double gain) const
+{
+	return static_cast<uint32_t>(std::max(0.0, gain * gainScale));
+}
+
+double CamHelperArducamPivariety::gain(uint32_t gainCode) const
+{
+	return gainCode / gainScale;
+}
+
+unsigned int CamHelperArducamPivariety::hideFramesStartup() const
+{
+	return 1;
+}
+
+unsigned int CamHelperArducamPivariety::hideFramesModeSwitch() const
+{
+	return 1;
+}
+
+static CamHelper *create()
+{
+	return new CamHelperArducamPivariety();
+}
+
+static RegisterCamHelper reg("arducam-pivariety", &create);
